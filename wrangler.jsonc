{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "riftneighbours",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-16",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/auth/*"] },
  "triggers": { "crons": ["0 16 * * *"] },
  "vars": {
    "GOOGLE_CLIENT_ID": "834502335714-gqdgcjjjnnaleugcbvlr4lnp0psa1c9j.apps.googleusercontent.com",
    "APP_ORIGIN": "https://riftneighbours.coulomb-alexandre.workers.dev"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "riftneighbours",
    "database_id": "1ab160a3-338e-4545-8cdc-7d6f261c4299",
    "migrations_dir": "migrations"
  }]
}
